# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key used by /api/generate
ANTHROPIC_API_KEY=

# REQUIRED. Comma-separated emails allowed to call /api/generate (second lock besides disabling sign-ups)
ALLOWED_EMAILS=

# n8n webhook that receives new-comment events (n8n then sends Telegram and/or Gmail)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Public base URL, used to build the link in notifications. e.g. http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Name shown on your replies to clients (default: Studio)
NEXT_PUBLIC_OWNER_NAME=
